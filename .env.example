# ==============================================================================
# Streaming Speech-to-Text Environment Configuration
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Speech Recognition Model Settings (Sherpa-ONNX Zipformer)
MODEL_REPO_ID=csukuangfj/sherpa-onnx-streaming-zipformer-en-kroko-2025-08-06
SAMPLE_RATE=16000
NUM_THREADS=2

# Audio Storage: set to true to record session audio into WAV files
SAVE_AUDIO=true

# Storage Directories
DATA_DIR=./data
MODEL_DIR=./models/zipformer

# CORS Allowed Origins (comma-separated origins, or * for all)
CORS_ORIGINS=*
